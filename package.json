{
  "name": "morph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "design:sync": "node --experimental-strip-types --no-warnings scripts/design-sync.ts",
    "design:lint": "designmd lint DESIGN.md",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "prepare": "husky",
    "jev:smoke": "node --experimental-strip-types --no-warnings scripts/jev-eval.ts smoke",
    "jev:eval": "node --experimental-strip-types --no-warnings scripts/jev-eval.ts eval",
    "jev:simulate": "node --experimental-strip-types --no-warnings scripts/jev-eval.ts simulate",
    "luma:simulate": "node --experimental-strip-types --no-warnings scripts/luma-simulate.ts",
    "jev:states": "node --experimental-strip-types --no-warnings scripts/jev-eval.ts states",
    "jev:raw": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/jev-raw.ts"
  },
  "dependencies": {
    "@ebay/nice-modal-react": "^1.2.13",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-table": "^9.3.1",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "next": "16.4.2",
    "nuqs": "2.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sigma": "^4.0.3",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@google/design.md": "^0.4.0",
    "@tailwindcss/turbopack": "^4",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "graphology-types": "^0.24.8",
    "husky": "^9.1.7",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.16"
  },
  "packageManager": "pnpm@10.11.0"
